# --- Server ---
PORT=5000
# MongoDB Atlas connection string (create a free cluster at https://cloud.mongodb.com)
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/socialdb?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/socialdb
# Long random string used to sign JWTs
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins for CORS (used in production).
# Local dev allows http://localhost:5173 automatically.
CLIENT_URL=http://localhost:5173
# Max JSON body size (base64 images inflate size — 8mb allows ~5-6MB images)
JSON_LIMIT=8mb
